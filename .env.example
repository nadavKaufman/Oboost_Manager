# OBoost Manager — Supabase connection (copy to .env.local and fill in real values)
# .env.local is gitignored and never committed.
# These two variables are the only ones the frontend needs.
# The service_role key must NEVER go in a VITE_ variable.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
